{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,

		/* Path aliases */
		"baseUrl": ".",
		"paths": {
			"@Components/*": ["src/components/*"],
			"@Components": ["src/components"],
			"@Context/*": ["src/context/*"],
			"@Context": ["src/context"],
			"@Pages/*": ["src/pages/*"],
			"@Pages": ["src/pages"],
			"@Layout/*": ["src/layout/*"],
			"@Layout": ["src/layout"],
			"@Util/*": ["src/util/*"],
			"@Util": ["src/util"],
			"@Types/*": ["src/types/*"],
			"@Types": ["src/types"]
		}
	},
	"include": ["src"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
